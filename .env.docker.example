# Container path used by Docker Compose.
LLAMA_MODEL_PATH=/models/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf

# CPU by default. Set -1 only when llama-cpp-python was built with a GPU backend.
LLAMA_N_GPU_LAYERS=0
LLAMA_N_CTX=4096
LLAMA_N_THREADS=0
LLAMA_PRELOAD_MODEL=false
LLAMA_VERBOSE=false

# Usually leave empty so llama.cpp uses the GGUF tokenizer chat template.
LLAMA_CHAT_FORMAT=

# Optional bearer token for /v1/* endpoints.
API_KEY=
